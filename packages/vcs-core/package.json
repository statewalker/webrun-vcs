{
  "name": "@statewalker/vcs-core",
  "version": "0.3.3",
  "description": "Core VCS interfaces, storage abstractions, and history management",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-vcs/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-vcs/tree/main/packages/vcs-core#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-vcs.git",
    "directory": "packages/vcs-core"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./history": {
      "source": "./src/history/index.ts",
      "types": "./dist/history/index.d.ts",
      "import": "./dist/history/index.js"
    },
    "./storage": {
      "source": "./src/storage/index.ts",
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./backend": {
      "source": "./src/backend/index.ts",
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    },
    "./serialization": {
      "source": "./src/serialization/index.ts",
      "types": "./dist/serialization/index.d.ts",
      "import": "./dist/serialization/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/webrun-storage": "catalog:",
    "@statewalker/vcs-utils": "workspace:^"
  },
  "devDependencies": {
    "@statewalker/vcs-utils-node": "workspace:^",
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
