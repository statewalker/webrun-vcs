{
  "name": "@statewalker/vcs-working-tree",
  "version": "0.2.0",
  "description": "Git working-tree layer — index/staging, status, checkout, ignore, worktree, and merge/rebase operation state, over vcs-core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/statewalker/webrun-vcs.git",
    "directory": "packages/working-tree"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./staging": {
      "types": "./dist/staging/index.d.ts",
      "import": "./dist/staging/index.js"
    },
    "./transformation": {
      "types": "./dist/transformation/index.d.ts",
      "import": "./dist/transformation/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/vcs-core": "workspace:*",
    "@statewalker/vcs-utils": "workspace:*"
  },
  "devDependencies": {
    "@statewalker/vcs-utils-node": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
