{
  "name": "@statewalker/vcs-workspace",
  "version": "0.2.0",
  "description": "Thin cross-axis orchestration (publish/update/checkpoint/restore) composing files-sync + vcs-working-tree + vcs-transport",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/statewalker/webrun-vcs.git",
    "directory": "packages/workspace"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:fix": "biome check --write --unsafe .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/files-sync": "catalog:",
    "@statewalker/vcs-working-tree": "workspace:^",
    "@statewalker/vcs-core": "workspace:^",
    "@statewalker/vcs-transport": "workspace:^",
    "@statewalker/content-store": "catalog:",
    "@statewalker/webrun-files": "catalog:"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/storage": "catalog:",
    "rolldown": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
