{
  "name": "@statewalker/vcs-workspace",
  "version": "0.3.2",
  "description": "Thin cross-axis orchestration (publish/update/checkpoint/restore) composing files-sync + vcs-working-tree + vcs-transport, and network sync of a workspace with a remote repository",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-vcs/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-vcs/tree/main/packages/vcs-workspace#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-vcs.git",
    "directory": "packages/vcs-workspace"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./net": {
      "source": "./src/net/index.ts",
      "types": "./dist/net/index.d.ts",
      "import": "./dist/net/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:fix": "biome check --write --unsafe .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests"
  },
  "dependencies": {
    "@statewalker/webrun-files-sync": "catalog:",
    "@statewalker/vcs-working-tree": "workspace:^",
    "@statewalker/vcs-core": "workspace:^",
    "@statewalker/vcs-transport": "workspace:^",
    "@statewalker/vcs-utils": "workspace:^",
    "@statewalker/webrun-content-store": "catalog:",
    "@statewalker/webrun-files": "catalog:"
  },
  "devDependencies": {
    "@statewalker/httpeers-access": "catalog:",
    "@statewalker/vcs-transport-httpeers": "workspace:^",
    "@statewalker/vcs-utils-node": "workspace:^",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-storage": "catalog:",
    "rolldown": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
