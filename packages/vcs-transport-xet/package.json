{
  "name": "@statewalker/vcs-transport-xet",
  "version": "0.2.4",
  "description": "Git LFS custom transfer agent (Xet) — chunk-dedup transfer via content-transfer, falls back to basic LFS",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-vcs/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-vcs/tree/main/packages/vcs-transport-xet#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-vcs.git",
    "directory": "packages/vcs-transport-xet"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:fix": "biome check --write --unsafe .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/webrun-content-store": "catalog:",
    "@statewalker/webrun-content-transfer": "catalog:",
    "@statewalker/vcs-transport-lfs": "workspace:^",
    "@statewalker/webrun-http-streams": "catalog:",
    "@statewalker/webrun-streams": "catalog:"
  },
  "devDependencies": {
    "@statewalker/webrun-storage": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "rolldown": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
