{
  "name": "@statewalker/vcs-transport-httpeers",
  "version": "0.2.0",
  "description": "Git smart HTTP and Git LFS over an httpeers mesh: Biscuit membership tokens, per-ref push authorization, multi-source LFS downloads",
  "bugs": {
    "url": "https://github.com/statewalker/webrun-vcs/issues"
  },
  "homepage": "https://github.com/statewalker/webrun-vcs/tree/main/packages/vcs-transport-httpeers#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/webrun-vcs.git",
    "directory": "packages/vcs-transport-httpeers"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:fix": "biome check --write --unsafe .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests"
  },
  "dependencies": {
    "@statewalker/httpeers-access": "catalog:",
    "@statewalker/httpeers-core": "catalog:",
    "@statewalker/vcs-core": "workspace:^",
    "@statewalker/vcs-transport": "workspace:^",
    "@statewalker/vcs-transport-lfs": "workspace:^",
    "@statewalker/vcs-utils": "workspace:^",
    "@statewalker/webrun-http-streams": "catalog:",
    "@statewalker/webrun-streams": "catalog:"
  },
  "devDependencies": {
    "@statewalker/vcs-commands": "workspace:^",
    "@statewalker/webrun-files-mem": "catalog:",
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
